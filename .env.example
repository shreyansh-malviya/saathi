# Copy to server/.env for local development. Never commit real values.

# MongoDB connection string including the database name.
# Atlas: Database > Connect > Drivers. Example:
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/saathi?retryWrites=true&w=majority"

# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
CRON_SECRET=change-me-too

# Web Push (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Public URL of the app (used in invite and pairing links)
CLIENT_URL=http://localhost:5173
PORT=5050
